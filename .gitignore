# ============================================================
# SYNY 校园网自动认证 —— Git 跟踪范围
# 原则：只跟踪源码 / 脚本 / 设计稿；排除构建产物、依赖缓存、本机与工具状态。
# ============================================================

# ---- 构建产物 / 应用包 ----
/SYNY.app/
/build/
/dist/
SYNY/.build/
*.app

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- SwiftPM ----
.build/
.swiftpm/

# ---- macOS 系统文件 ----
.DS_Store
.AppleDouble
.LSOverride
._*
# 例外：DMG 窗口布局模板必须进版本库（Finder 的布局信息就存在 .DS_Store 里）
!packaging/dmg_layout.DS_Store

# ---- 编辑器 / 工具本地状态（按需可放开）----
.vscode/
.idea/
.workbuddy/

# ---- 运行日志 / 临时文件 ----
*.log
